# Copy to your local shell environment; this repository does not load .env files.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/CareConnect
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-local-password

# Enable when the backend is served through HTTPS in production.
SESSION_COOKIE_SECURE=false
CARECONNECT_CSRF_ENABLED=true

# Optional OpenAI-compatible chat provider.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional Daily video provider (secret stays on the backend).
DAILY_API_KEY=

# Optional; required only if administrator self-registration is enabled.
CARECONNECT_ADMIN_SIGNUP_CODE=
